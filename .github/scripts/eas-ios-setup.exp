#!/usr/bin/expect -f
# First iPhone production build, run once by the Store build workflow ("ios-setup").
#
# eas-cli won't create a missing distribution certificate in --non-interactive mode, so this runs
# `eas build` interactively inside a pseudo-terminal. The App Store Connect team key in the
# EXPO_ASC_* variables signs EAS in to Apple (no password), and EAS then registers the bundle ids,
# makes the certificate and both provisioning profiles (app + share extension) and stores them,
# so every later build can run non-interactively ("ios").
#
# It answers "yes" only to the credential questions below (checked against eas-cli 27.11). Any
# other yes/no question, any pick-list (the first choice can be harmful, e.g. Apple Team Type lists
# Enterprise first), an Apple password prompt or a certificate-revoke list stops the run instead,
# so a person can look. eas.json sets cli.promptToConfigurePushNotifications false: only an Apple
# password login can make a push key, so that key is added separately.
set timeout 900
log_user 1
set expected {Generate a new Apple Distribution Certificate\?|Generate a new Apple Provisioning Profile\?|Reuse this distribution certificate\?}

proc fail {code message} {
  send_user "\n::error::$message\n"
  exit $code
}

spawn eas build --profile production --platform ios --no-wait
expect {
  -re {Apple ID:|Password \(for |Apple ID Password} {
    fail 4 "EAS asked for an Apple password, so the App Store Connect key was not used"
  }
  -re {Select certificates to revoke} {
    fail 6 "Apple has too many distribution certificates; revoke one by hand, then run ios-setup again"
  }
  -re {\(Y/n\)|\(y/N\)} {
    if {![regexp $expected $expect_out(buffer)]} {
      fail 6 "eas build asked a yes/no question this script doesn't answer (see the log above)"
    }
    # Answer, then read past the "yes" eas prints back, so a redraw of this question (or its text
    # left in the buffer) can't be taken for the next one.
    sleep 1
    send -- "y"
    expect {
      -re {yes} {}
      timeout { fail 5 "eas build didn't take the answer to its question" }
    }
    exp_continue
  }
  -re {Use arrow-keys|Space to select} {
    fail 6 "eas build showed a pick-list this script doesn't answer (see the log above)"
  }
  timeout {
    fail 5 "eas build went 15 minutes without a question this script answers or finishing; it may be waiting on a typed answer"
  }
  eof
}
# wait gives: pid spawn_id os_error value, plus extra fields when the child was killed by a signal
# (then value is 0), so anything but a clean exit fails the job.
set r [wait]
if {[lindex $r 2] != 0 || [llength $r] > 4} {
  fail 1 "eas build ended abnormally: $r"
}
exit [lindex $r 3]
