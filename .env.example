# Copy to .env. Find both values in Supabase: Project Settings → API Keys.
# The publishable key is safe to ship inside the app. Never put the secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set to 1 to run on the made-up demo members instead.
EXPO_PUBLIC_FORCE_DEMO=0
# Stage 3 (lane B): GIF search. An app key from developers.giphy.com (made to ship inside apps).
# Leave empty and the GIF button says GIFs aren't switched on yet.
EXPO_PUBLIC_GIPHY_KEY=
