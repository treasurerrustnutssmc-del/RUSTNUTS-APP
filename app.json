{
  "expo": {
    "name": "Rustnuts",
    "slug": "rustnutssmc",
    "scheme": "rustnuts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111010",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.rustnutssmc.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "au.com.rustnutssmc.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Rustnuts",
      "themeColor": "#8C1C24",
      "backgroundColor": "#111010"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rustnuts uses your photos so you can share them in club chats.",
          "cameraPermission": "Rustnuts uses your camera to scan the club's check-in code at rides and meetings, and to take photos and videos for club chats.",
          "microphonePermission": "Rustnuts uses your microphone for ride comms, and to record voice notes and the sound with videos for club chats."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rustnuts uses your location during a live ride, so the riders you're with can find you.",
          "locationAlwaysAndWhenInUsePermission": "Rustnuts keeps sharing your location with your ride while the screen is off. It switches itself off when the ride ends.",
          "locationAlwaysPermission": "Rustnuts keeps sharing your location with your ride while the screen is off. It switches itself off when the ride ends.",
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B92632",
          "sounds": [
            "./assets/sounds/v_twin_rev.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Rustnuts uses your camera to scan the club's check-in code at rides and meetings, and to take photos and videos for club chats.",
          "microphonePermission": "Rustnuts uses your microphone for ride comms, and to record voice notes and the sound with videos for club chats.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withShareExtensionPrivacy.js",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "image/*",
              "video/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*",
              "*/*"
            ]
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# LiveKit's WebRTC looks these classes up by name when it loads; its own rules keep the unprefixed package.\n-keep class livekit.org.jni_zero.** { *; }\n-keep class livekit.org.webrtc.** { *; }"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Rustnuts uses your microphone for ride comms, and to record voice notes and the sound with videos for club chats.",
          "recordAudioAndroid": true
        }
      ],
      "expo-maps"
    ],
    "owner": "rustnutssmcs-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/57ac4925-9517-41e2-8a45-4eeccd32abc5"
    },
    "extra": {
      "eas": {
        "projectId": "57ac4925-9517-41e2-8a45-4eeccd32abc5"
      }
    }
  }
}
