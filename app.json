{
  "expo": {
    "name": "Rustnuts",
    "slug": "rustnutssmc",
    "scheme": "rustnuts",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111010",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.rustnutssmc.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "au.com.rustnutssmc.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Rustnuts",
      "themeColor": "#8C1C24",
      "backgroundColor": "#111010"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rustnuts uses your photos so you can share them in club chats.",
          "cameraPermission": "Rustnuts uses your camera so you can take photos and videos for club chats.",
          "microphonePermission": "Rustnuts uses your microphone for ride comms, and to record sound with videos for club chats."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rustnuts uses your location during a live ride, so the riders you're with can find you.",
          "locationAlwaysAndWhenInUsePermission": "Rustnuts keeps sharing your location with your ride while the screen is off. It switches itself off when the ride ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B92632"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the club’s check-in code at rides and meetings.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "image/*",
              "video/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*",
              "*/*"
            ]
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ]
    ],
    "owner": "rustnutssmcs-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/57ac4925-9517-41e2-8a45-4eeccd32abc5"
    },
    "extra": {
      "eas": {
        "projectId": "57ac4925-9517-41e2-8a45-4eeccd32abc5"
      }
    }
  }
}
